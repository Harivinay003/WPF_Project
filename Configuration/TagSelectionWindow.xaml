<Window x:Class="WPFSCADA.Configuration.TagSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFSCADA.Configuration"
        mc:Ignorable="d"
         WindowStartupLocation="CenterOwner"
        Title="TagSelectionWindow" Height="550" Width="400">
    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            Text="Select Tag"
            FontSize="22"
            FontWeight="DemiBold"
            Margin="0,0,0,15"/>

        <DataGrid
            x:Name="TagsGrid"
            Grid.Row="1"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            SelectionMode="Extended">

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">

                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="Black"/>

                    <Style.Triggers>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="DodgerBlue"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>

                    </Style.Triggers>

                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>

                <DataGridTextColumn
                    Header="Id"
                    Binding="{Binding Id}"
                    Width="20"/>

                <DataGridTextColumn
                    Header="Name"
                    Binding="{Binding Name}"
                    Width="170"/>

                <DataGridTextColumn
                    Header="Description"
                    Binding="{Binding Description}"
                    Width="210"/>

                <!--<DataGridTextColumn
                    Header="Units"
                    Binding="{Binding Units}"
                    Width="100"/>-->

            </DataGrid.Columns>

        </DataGrid>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,15,0,0">

            <Button
                Content="Cancel"
                Width="60"
                Height="25"
                Margin="0,0,10,0"
                Click="Cancel_Click"/>

            <Button
                Content="Select"
                Width="60"
                Height="25"
                Click="Select_Click"/>

        </StackPanel>

    </Grid>
</Window>
