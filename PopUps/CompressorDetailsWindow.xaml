<Window x:Class="WPFSCADA.PopUps.CompressorDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Width="400"
        Height="470"
        WindowStartupLocation="CenterOwner">

    <Border Margin="8"
            Background="#F5F7FA"
            CornerRadius="10"
            BorderBrush="#D9E0E7"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16"
                              ShadowDepth="3"
                              Opacity="0.22"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- HEADER -->
            <Border Grid.Row="0"
                    Background="#374151"
                    CornerRadius="10,10,0,0">
                <Grid>
                    <TextBlock x:Name="UnitNameText"
                               Text="HS-01"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <Button Width="28"
                            Height="28"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Content="✕"
                            FontSize="16"
                            Foreground="White"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background"
                                        Value="Transparent"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                                <Setter Property="BorderThickness"
                                        Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="#374151"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button x:Name="ControlsTabButton"
                            Grid.Column="0"
                            Content="CONTROLS"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="#4B5563"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="ControlsTab_Click"/>
                    
                    <Button x:Name="EventsTabButton"
                            Grid.Column="1"
                            Content="EVENTS &amp; ALARMS"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#4B5563"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="EventsTab_Click"/>
                    
                    <Button x:Name="MaintenanceTabButton"
                            Grid.Column="2"
                            Content="MAINTENANCE"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="#4B5563"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="MaintenanceTab_Click"/>
                </Grid>
            </Border>
            <Grid Grid.Row="2"  Margin="18">
                <Grid x:Name="ControlsTab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0">
                            <Border Background="White"
                                    BorderBrush="#D9E0E7"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Margin="0,0,0,12">
                                <StackPanel>

                                    <Border Background="#374151"
                                            CornerRadius="6,6,0,0"
                                            Height="36">
                                        <TextBlock Text="MODE &amp; ROLE"
                                                   Foreground="White"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <Grid Margin="14,14,14,14">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="42"/>
                                            <RowDefinition Height="42"/>
                                        </Grid.RowDefinitions>
                                        
                                        <TextBlock Grid.Row="0"
                                                   Text="Operating Mode"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#374151"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Left"/>
                                        <Border Grid.Row="0"
                                                Width="190"
                                                Height="34"
                                                HorizontalAlignment="Right"
                                                Background="#E8F0FE"
                                                CornerRadius="6"
                                                Padding="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Button x:Name="ManualModeButton"
                                                        Grid.Column="0"
                                                        Content="MANUAL"
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Foreground="#64748B"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Click="ManualModeButton_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="5">
                                                                <ContentPresenter
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                
                                                <Button x:Name="AutoModeButton"
                                                        Grid.Column="1"
                                                        Content="AUTO"
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Foreground="White"
                                                        Background="#1E73E8"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Click="AutoModeButton_Click">                                                    
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="5">
                                                                <ContentPresenter
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <TextBlock Grid.Row="1"
                                                   Text="Role"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="#374151"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Left"/>
                                        <Border Grid.Row="1"
                                                x:Name="MasterSlavePanel"
                                                Width="190"
                                                Height="34"
                                                HorizontalAlignment="Right"
                                                Background="#E8F0FE"
                                                CornerRadius="6"
                                                Padding="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Button x:Name="MasterButton"
                                                        Grid.Column="0"
                                                        Content="MASTER"
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Foreground="White"
                                                        Background="#1E73E8"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Click="MasterButton_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="5">
                                                                <ContentPresenter
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <Button x:Name="SlaveButton"
                                                        Grid.Column="1"
                                                        Content="SLAVE"
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Foreground="#64748B"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Click="SlaveButton_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="5">
                                                                <ContentPresenter
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="White"
                                    BorderBrush="#D9E0E7"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                <StackPanel>

                                    <Border Background="#374151"
                                            CornerRadius="6,6,0,0"
                                            Height="36">
                                        <TextBlock Text="CONTROLS"
                                                   Foreground="White"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="14,14,14,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Button x:Name="StartButton"
                                                    Grid.Column="0"
                                                    Height="38"
                                                    Margin="0,0,5,0"
                                                    Content="▶  START"
                                                    FontSize="16"
                                                    FontWeight="Bold"
                                                    Foreground="White"
                                                    Background="#16A34A"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Click="StartButton_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="5">
                                                            <ContentPresenter
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            
                                            <Button x:Name="StopButton"
                                                    Grid.Column="1"
                                                    Height="38"
                                                    Margin="5,0,0,0"
                                                    Content="■  STOP"
                                                    FontSize="16"
                                                    FontWeight="Bold"
                                                    Foreground="White"
                                                    Background="#DC2626"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Click="StopButton_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="5">
                                                            <ContentPresenter
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>

                                        <Button x:Name="AlarmResetButton"
                                                Height="38"
                                                Margin="0,10,0,0"
                                                Content="🔔  ALARM RESET"
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Foreground="#374151"
                                                Background="#F3F4F6"
                                                BorderBrush="#D9E0E7"
                                                BorderThickness="1"
                                                Cursor="Hand"
                                                Click="AlarmResetButton_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="5">
                                                        <ContentPresenter
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <Grid x:Name="EventsTab"
                      Visibility="Collapsed">
                    <TextBlock Text="EVENTS &amp; ALARMS"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#374151"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Grid>
                <Grid x:Name="MaintenanceTab"
                      Visibility="Collapsed">
                    <TextBlock Text="MAINTENANCE"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#374151"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>