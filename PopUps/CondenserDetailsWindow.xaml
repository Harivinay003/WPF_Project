<Window x:Class="WPFSCADA.PopUps.CondenserDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"        
        AllowsTransparency="True"
        Background="Transparent"        
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Width="450"
        Height="840"
        xmlns:helpers="clr-namespace:WPFSCADA.Helpers"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        WindowStartupLocation="CenterOwner">

    <Border Margin="8"
            Background="#F5F7FA"
            CornerRadius="10"
            BorderBrush="#D9E0E7"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16"
                              ShadowDepth="3"
                              Opacity="0.22"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#374151"
                    CornerRadius="10,10,0,0">

                <Grid>
                    <TextBlock x:Name="UnitNameText"
                               Text="EVAP CONDENSER-1"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <Button Width="28"
                            Height="28"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Content="✕"
                            FontSize="13"
                            Foreground="White"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CloseButton_Click">

                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background"
                                        Value="Transparent"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                                <Setter Property="BorderThickness"
                                        Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="#4B8FE8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,0,0,1">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="ControlsTabButton"
                            Grid.Column="0"
                            Content="CONTROLS"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="#374151"
                            Background="#F0F2F4"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="ControlsTab_Click"/>

                    <Button x:Name="EventsTabButton"
                            Grid.Column="1"
                            Content="EVENTS &amp; ALARMS"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#4B5563"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="EventsTab_Click"/>

                    <Button x:Name="MaintenanceTabButton"
                            Grid.Column="2"
                            Content="MAINTENANCE"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="#4B5563"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="MaintenanceTab_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2"
                  Margin="18">

                <Grid x:Name="ControlsTab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                            <Border Background="White"
                                    BorderBrush="#D9E0E7"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <Border Background="#374151"
                                            CornerRadius="6,6,0,0"
                                            Height="36">
                                        <TextBlock Text="MODE &amp; ROLE"
                                                   Foreground="White"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <Grid Margin="14">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="42"/>
                                            <RowDefinition Height="42"/>
                                            <RowDefinition Height="42"/>
                                        </Grid.RowDefinitions>
                                        
                                        <TextBlock Grid.Row="0"
                                                   Text="Control Mode"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#374151"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Left"/>

                                        <Border Grid.Row="0"
                                                Width="115"
                                                Height="28"
                                                HorizontalAlignment="Left"
                                                Background="#E8F0FE"
                                                CornerRadius="6"
                                                Margin="215,0,0,0">

                                            <TextBlock x:Name="ControlModeText"
                                                       Text="--"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="#16A34A"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       helpers:TagProperties.ConfigKey="RemoteFb"/>

                                        </Border>
                                        
                                        <TextBlock Grid.Row="1"
                                                   Text="Operating Mode"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#374151"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Left"/>

                                        <Border Grid.Row="1"
                                                Width="190"
                                                Height="34"
                                                HorizontalAlignment="Right"
                                                Background="#E8F0FE"
                                                CornerRadius="6"
                                                Padding="2">

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Button x:Name="ManualModeButton"
                                                        Grid.Column="0"
                                                        Content="MANUAL"
                                                        FontSize="15"
                                                        FontWeight="SemiBold"
                                                        Foreground="#64748B"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Click="ManualModeButton_Click"
                                                        helpers:TagProperties.ConfigKey="AutoManual">

                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="5">
                                                                <ContentPresenter
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <Button x:Name="AutoModeButton"
                                                        Grid.Column="1"
                                                        Content="AUTO"
                                                        FontSize="15"
                                                        FontWeight="SemiBold"
                                                        Foreground="White"
                                                        Background="#1E73E8"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Click="AutoModeButton_Click"
                                                        helpers:TagProperties.ConfigKey="AutoManual">

                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="5">
                                                                <ContentPresenter
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <TextBlock Grid.Row="2"
                                                   Text="Role"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#374151"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Left"/>

                                        <Border Grid.Row="2"
                                                Width="190"
                                                Height="34"
                                                HorizontalAlignment="Right"
                                                Background="#E8F0FE"
                                                CornerRadius="6"
                                                Padding="2">

                                                <StackPanel Orientation="Horizontal" Height="24">

                                                    <Button x:Name="MasterButton"
                                                              helpers:TagProperties.ConfigKey="MasterSelection" Content="MASTER"
                                                            Width="60"
                                                            Height="24"
                                                            Padding="0"
                                                            FontSize="14"
                                                            FontWeight="SemiBold"
                                                            Background="#1E73E8"
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Click="MasterButton_Click"/>

                                                    <TextBlock x:Name="Slave1Text"
                                                               Text="SLAVE 1"
                                                               helpers:TagProperties.ConfigKey="Slave1"
                                                               Width="58"
                                                               Height="24"
                                                               TextAlignment="Center"
                                                               VerticalAlignment="Center"
                                                              Padding="0,5,0,0"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="#64748B"
                                                               Background="#E8EEF7"/>

                                                    <TextBlock x:Name="Slave2Text"
                                                               Text="SLAVE 2"
                                                                helpers:TagProperties.ConfigKey="Slave2"
                                                               Width="58"
                                                               Height="24"
                                                               TextAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Padding="0,5,0,0"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="#64748B"
                                                               Background="#E8EEF7"/>
                                                </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="White" BorderBrush="#D9E0E7" BorderThickness="1" CornerRadius="7">
                                <StackPanel>
                                    <Border Background="#374151" CornerRadius="6,6,0,0" Height="36">
                                        <TextBlock Text="CONDENSER CONTROLS" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Margin="14">
                                        <!-- FAN 1 -->
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="FAN-1" FontSize="15" FontWeight="Bold" Foreground="#374151" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                                                <Grid Height="34">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Name="Fan1StartButton" Grid.Column="0" Height="32" Margin="10,0,16,0" Content="▶  START" FontSize="14" FontWeight="Bold" Foreground="White" Background="#16A34A" BorderThickness="0" Cursor="Hand" Click="Fan1StartButton_Click" helpers:TagProperties.ConfigKey="Fan1Start">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <Button x:Name="Fan1StopButton" Grid.Column="1" Height="32" Margin="16,0,10,0" Content="■  STOP" FontSize="14" FontWeight="Bold" Foreground="White" Background="#DC2626" BorderThickness="0" Cursor="Hand" Click="Fan1StopButton_Click" helpers:TagProperties.ConfigKey="Fan1Stop">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>

                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="RPM" FontSize="13" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock x:Name="Fan1RpmText" Text="--" FontSize="17" FontWeight="Bold" Foreground="#374151" VerticalAlignment="Center" helpers:TagProperties.ConfigKey="Fan1Rpm"/>
                                                       
                                                        <Button x:Name="Fan1RpmEditButton" Width="28" Height="28" Margin="3,0,0,0" Content="✎" FontSize="15" Foreground="#374151" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Fan1RpmEditButton_Click">
                                                            <Button.ToolTip>Edit FAN-1 RPM</Button.ToolTip>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Margin="0,5,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="STATUS" FontSize="13" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="Fan1FeedbackText" Grid.Column="1" Text="STOPPED" FontSize="15" FontWeight="Bold" Foreground="#6B7280" HorizontalAlignment="Right" VerticalAlignment="Center" helpers:TagProperties.ConfigKey="Fan1RunFb"/>
                                                    <TextBlock Text="" Height="1" Width="1" Opacity="0" IsHitTestVisible="True" helpers:TagProperties.ConfigKey="Fan1TripFb"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- FAN 2 -->
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="FAN-2" FontSize="15" FontWeight="Bold" Foreground="#374151" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                <Grid Height="34">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Name="Fan2StartButton" Grid.Column="0" Height="32" Margin="10,0,16,0" Content="▶  START" FontSize="14" FontWeight="Bold" Foreground="White" Background="#16A34A" BorderThickness="0" Cursor="Hand" Click="Fan2StartButton_Click" helpers:TagProperties.ConfigKey="Fan2Start">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <Button x:Name="Fan2StopButton" Grid.Column="1" Height="32" Margin="16,0,10,0" Content="■  STOP" FontSize="14" FontWeight="Bold" Foreground="White" Background="#DC2626" BorderThickness="0" Cursor="Hand" Click="Fan2StopButton_Click" helpers:TagProperties.ConfigKey="Fan2Stop">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="RPM" FontSize="13" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock x:Name="Fan2RpmText" Text="--" FontSize="17" FontWeight="Bold" Foreground="#374151" VerticalAlignment="Center" helpers:TagProperties.ConfigKey="Fan2Rpm"/>
                                                       
                                                        <Button x:Name="Fan2RpmEditButton" Width="28" Height="28" Margin="3,0,0,0" Content="✎" FontSize="15" Foreground="#374151" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Fan2RpmEditButton_Click">
                                                            <Button.ToolTip>Edit FAN-2 RPM</Button.ToolTip>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Margin="0,5,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="STATUS" FontSize="13" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="Fan2FeedbackText" Grid.Column="1" Text="STOPPED" FontSize="15" FontWeight="Bold" Foreground="#6B7280" HorizontalAlignment="Right" VerticalAlignment="Center" helpers:TagProperties.ConfigKey="Fan2RunFb"/>
                                                    <TextBlock Text="" Height="1" Width="1" Opacity="0" IsHitTestVisible="True" helpers:TagProperties.ConfigKey="Fan2TripFb"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- PUMP -->
                                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
                                            <StackPanel>
                                                <TextBlock Text="PUMP" FontSize="15" FontWeight="Bold" Foreground="#374151" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                <Grid Height="34">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Name="PumpStartButton" Grid.Column="0" Height="32" Margin="10,0,16,0" Content="▶  START" FontSize="14" FontWeight="Bold" Foreground="White" Background="#16A34A" BorderThickness="0" Cursor="Hand" Click="PumpStartButton_Click" helpers:TagProperties.ConfigKey="PumpStart">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <Button x:Name="PumpStopButton" Grid.Column="1" Height="32" Margin="16,0,10,0" Content="■  STOP" FontSize="14" FontWeight="Bold" Foreground="White" Background="#DC2626" BorderThickness="0" Cursor="Hand" Click="PumpStopButton_Click" helpers:TagProperties.ConfigKey="PumpStop">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                         

                                                <Grid Margin="0,5,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="STATUS" FontSize="13" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="PumpFeedbackText" Grid.Column="1" Text="STOPPED" FontSize="15" FontWeight="Bold" Foreground="#6B7280" HorizontalAlignment="Right" VerticalAlignment="Center" helpers:TagProperties.ConfigKey="PumpRunFb"/>
                                                    <TextBlock Text="" Height="1" Width="1" Opacity="0" IsHitTestVisible="True" helpers:TagProperties.ConfigKey="PumpTripFb"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="EventsTab"
                      Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="EVENTS &amp; ALARMS"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#374151"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="No events available"
                                   Margin="0,8,0,0"
                                   FontSize="11"
                                   Foreground="#6B7280"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                </Grid>


                <Grid x:Name="MaintenanceTab"
                      Visibility="Collapsed"
                      Background="#F5F7FA" >

                    <Border Margin="10,5,15,0"
                            Background="White"
                            BorderBrush="#D7DCE5"
                            BorderThickness="1"
                            CornerRadius="8"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="#374151"
                                    CornerRadius="7,7,0,0">
                                
                                <TextBlock Text="RUN HOURS"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Row="1"  Margin="14,8,14,10">
                                <!-- FAN 1 -->
                                <Grid Height="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Fan 1"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#374151"
                                               VerticalAlignment="Center"/>                                    
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="Fan1RunHoursText"
                                                   Text="--"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1F2937"/>
                                        <TextBlock Text=" h"
                                                   FontSize="12"
                                                   Foreground="#64748B"/>
                                        <TextBlock Text="  :  "
                                                   FontSize="10"
                                                   Foreground="#94A3B8"/>
                                        <TextBlock x:Name="Fan1RunMinutesText"
                                                   Text="--"
                                                   FontSize="14"
                                                   Foreground="#64748B"/>
                                        <TextBlock Text=" min"
                                                   FontSize="12"
                                                   Foreground="#94A3B8"/>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1"
                                        Background="#EEF2F7"
                                        Margin="0,2"/>
                                <!-- FAN 2 -->
                                <Grid Height="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Fan 2"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#374151"
                                               VerticalAlignment="Center"/>
                                    
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">

                                        <TextBlock x:Name="Fan2RunHoursText"
                                                   Text="--"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1F2937"/>
                                        <TextBlock Text=" h"
                                                   FontSize="12"
                                                   Foreground="#64748B"/>
                                        <TextBlock Text="  :  "
                                                   FontSize="10"
                                                   Foreground="#94A3B8"/>
                                        <TextBlock x:Name="Fan2RunMinutesText"
                                                   Text="--"
                                                   FontSize="14"
                                                   Foreground="#64748B"/>
                                        <TextBlock Text=" min"
                                                   FontSize="12"
                                                   Foreground="#94A3B8"/>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1"
                                        Background="#EEF2F7"
                                        Margin="0,2"/>
                                <!-- PUMP -->
                                <Grid Height="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Pump"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#374151"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="PumpRunHoursText"
                                                   Text="--"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1F2937"/>
                                        <TextBlock Text=" h"
                                                   FontSize="12"
                                                   Foreground="#64748B"/>
                                        <TextBlock Text="  :  "
                                                   FontSize="10"
                                                   Foreground="#94A3B8"/>
                                        <TextBlock x:Name="PumpRunMinutesText"
                                                   Text="--"
                                                   FontSize="14"
                                                   Foreground="#64748B"/>
                                        <TextBlock Text=" min"
                                                   FontSize="12"
                                                   Foreground="#94A3B8"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>