<Window x:Class="WPFSCADA.PopUps.ColdStoreDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WPFSCADA.Controls"
        xmlns:root="clr-namespace:WPFSCADA"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Width="450"
        Height="750"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="ToggleStyle"
               TargetType="{x:Type root:LabeledToggleButton}">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#FFD0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="root:LabeledToggleButton">
                        <Border x:Name="Root"
                                CornerRadius="0"
                                Background="#FFFFFF"
                                SnapsToDevicePixels="True"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Sliding thumb -->
                                <Border x:Name="Thumb"
                                        CornerRadius="0"
                                        Grid.Column="0"
                                        Background="{StaticResource PrimaryGreenBrush}">
                                    <Border.RenderTransform>
                                        <TranslateTransform
                                            x:Name="ThumbTransform"
                                            X="0"/>
                                    </Border.RenderTransform>
                                </Border>
                                <!-- LEFT -->
                                <TextBlock x:Name="LeftLabel"
                                           Grid.Column="0"
                                           Padding="2"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="10"
                                           FontWeight="DemiBold"
                                           Foreground="White"
                                           Text="{TemplateBinding OffText}"/>
                                <!-- RIGHT -->
                                <TextBlock x:Name="RightLabel"
                                           Grid.Column="1"
                                           Padding="2"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="10"
                                           FontWeight="DemiBold"
                                           Foreground="#333"
                                           Text="{TemplateBinding OnText}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#E7F6FF"/>
                            </Trigger>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="LeftLabel"
                                        Property="Foreground"
                                        Value="#333"/>
                                <Setter TargetName="RightLabel"
                                        Property="Foreground"
                                        Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ThumbTransform"
                                                Storyboard.TargetProperty="X"
                                                To="49"
                                                Duration="0:0:0.12"
                                                FillBehavior="HoldEnd"/>

                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ThumbTransform"
                                                Storyboard.TargetProperty="X"
                                                To="0"
                                                Duration="0:0:0.12"
                                                FillBehavior="HoldEnd"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="Root"
                                        Property="Opacity"
                                        Value="0.45"/>
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="#E5E7EB"/>
                                <Setter TargetName="LeftLabel"
                                        Property="Foreground"
                                        Value="#9CA3AF"/>
                                <Setter TargetName="RightLabel"
                                        Property="Foreground"
                                        Value="#9CA3AF"/>
                                <Setter TargetName="Thumb"
                                        Property="Background"
                                        Value="#BDBDBD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- TAB TEXT -->
        <Style x:Key="TabTextStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="11"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Foreground"
                    Value="#4B5563"/>
            <Setter Property="HorizontalAlignment"
                    Value="Center"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>
        <!-- STATUS BOX -->
        <Style x:Key="StatusBoxStyle"
               TargetType="Border">
            <Setter Property="Width"
                    Value="115"/>
            <Setter Property="Height"
                    Value="25"/>
            <Setter Property="HorizontalAlignment"
                    Value="Left"/>
            <Setter Property="CornerRadius"
                    Value="5"/>
            <Setter Property="Background"
                    Value="#E8F1FF"/>
        </Style>
        <!-- DEFROST BUTTON -->
        <Style x:Key="DefrostButtonStyle"
               TargetType="Button">
            <Setter Property="Width"
                    Value="145"/>
            <Setter Property="Height"
                    Value="32"/>
            <Setter Property="Background"
                    Value="{StaticResource PrimaryBlueBrush}"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="FontSize"
                    Value="11"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="#155FBE"/>
                </Trigger>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Opacity"
                            Value="0.45"/>
                    <Setter Property="Cursor"
                            Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- MODE BUTTON -->
        <Style x:Key="ModeButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="#4B5563"/>
            <Setter Property="FontSize"
                    Value="10"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Opacity"
                            Value="0.45"/>
                    <Setter Property="Cursor"
                            Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- VALVE BUTTON -->
        <Style x:Key="ValveButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="#4B5563"/>
            <Setter Property="FontSize"
                    Value="10"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Opacity"
                            Value="0.45"/>
                    <Setter Property="Cursor"
                            Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- SECTION HEADER -->
        <Style x:Key="SectionHeaderStyle"
       TargetType="Border">
            <Setter Property="Background"
            Value="#374151"/>
            <Setter Property="Height"
            Value="32"/>
            <Setter Property="CornerRadius"
            Value="5,5,0,0"/>
            <Setter Property="Margin"
            Value="0"/>
        </Style>

        <Style x:Key="SectionHeaderTextStyle"
       TargetType="TextBlock">
            <Setter Property="Foreground"
            Value="White"/>
            <Setter Property="FontSize"
            Value="12"/>
            <Setter Property="FontWeight"
            Value="Bold"/>
            <Setter Property="HorizontalAlignment"
            Value="Center"/>
            <Setter Property="VerticalAlignment"
            Value="Center"/>
        </Style>
        <Style x:Key="CycleTimeButtonStyle"
               TargetType="Button">
            <Setter Property="Width"
                    Value="105"/>
            <Setter Property="Height"
            Value="29"/>
            <Setter Property="FontSize"
            Value="14"/>
            <Setter Property="FontWeight"
            Value="Bold"/>
            <Setter Property="Foreground"
            Value="#2563EB"/>
            <Setter Property="Background"
            Value="#E8F1FF"/>
            <Setter Property="BorderThickness"
            Value="0"/>
            <Setter Property="Cursor"
            Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="5">
                            <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled"
                             Value="False">
                                <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#E5E7EB"/>
                                <Setter Property="Foreground"
                                Value="#9CA3AF"/>
                                <Setter Property="Opacity"
                                Value="0.65"/>
                                <Setter Property="Cursor"
                                Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- MAIN WINDOW -->
    <Border Margin="8"
        Background="#F5F7FA"
        CornerRadius="10"
        BorderBrush="#D9E0E7"
        BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect
            BlurRadius="18"
            ShadowDepth="4"
            Opacity="0.22"/>
        </Border.Effect>

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                Background="#374151"
                CornerRadius="10,10,0,0">
                <Grid>
                    <TextBlock x:Name="UnitNameText"
                           Text="COLD STORE"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                           Margin="20,0,0,0"/>
                    <!-- CLOSE BUTTON -->
                    <Button Width="35"
                        Height="35"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        Content="✕"
                        FontSize="20"
                        Foreground="White"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background"
                                    Value="Transparent"/>
                                <Setter Property="Foreground"
                                    Value="White"/>
                                <Setter Property="BorderThickness"
                                    Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver"
                                         Value="True">
                                        <Setter Property="Background"
                                            Value="#155FBE"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                Background="White"
                BorderBrush="#DDE3EA"
                BorderThickness="0,0,0,1">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            x:Name="ControlsTabButton"
                            Background="Transparent"
                            Foreground="#4B5563"
                            BorderThickness="0"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            Click="ControlsTabButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}">
                                    <TextBlock Text="CONTROLS"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Rectangle Grid.Column="1"
                               Width="1"
                               Fill="#D5D9DE"/>
                    <Button Grid.Column="2"
                            x:Name="CyclesTabButton"
                            Background="Transparent"
                            Foreground="#4B5563"
                            BorderThickness="0"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            Click="CyclesTabButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}">
                                    <TextBlock Text="CYCLES"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Rectangle Grid.Column="3"
                               Width="1"
                               Fill="#D5D9DE"/>

                    <Button Grid.Column="4"
                            x:Name="EventsTabButton"
                            Background="Transparent"
                            Foreground="#4B5563"
                            BorderThickness="0"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            Click="EventsTabButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}">
                                    <TextBlock Text="EVENTS &amp; ALARMS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Rectangle Grid.Column="5"
                               Width="1"
                               Fill="#D5D9DE"/>

                    <Button Grid.Column="6"
                            x:Name="MaintenanceTabButton"
                            Background="Transparent"
                            Foreground="#4B5563"
                            BorderThickness="0"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            Click="MaintenanceTabButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}">
                                    <TextBlock Text="MAINTENANCE"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

            </Border>
            <Border Grid.Row="2"
                Background="#F5F7FA"
                CornerRadius="0,0,10,10">

                <Grid>
                    <!--  CONTROLS -->
                    <Grid x:Name="ControlsContent"
                      Visibility="Visible">

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                            <StackPanel Width="380"
                                    Margin="14,12,14,14">
                                <!-- MODE & CONTROL -->
                                <Border Background="White"
                                    BorderBrush="#DDE3EA"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Margin="0,0,0,10">
                                    <StackPanel>
                                        <!-- HEADER -->
                                        <Border Style="{StaticResource SectionHeaderStyle}">

                                            <TextBlock Text="STATUS &amp; CONTROL"
                                                       FontSize="16"
                                                   Style="{StaticResource SectionHeaderTextStyle}"/>

                                        </Border>
                                        <Grid Margin="15,8,15,8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="40"/>
                                                <RowDefinition Height="40"/>
                                                <RowDefinition Height="40"/>
                                            </Grid.RowDefinitions>
                                            <!-- CONTROL MODE -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="190"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                       Text="Control Mode"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="#374151"
                                                       VerticalAlignment="Center"/>
                                                <Border Grid.Column="1"
                                                    Width="115"
                                                    Height="25"
                                                    HorizontalAlignment="Left"
                                                    CornerRadius="5"
                                                    Background="#E8F1FF">
                                                    <TextBlock x:Name="ControlModeText"
                                                           Text="REMOTE"
                                                           FontSize="15"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryGreenBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                            <!-- OPERATING MODE -->
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="190"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                       Text="Operating Mode"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="#374151"
                                                       VerticalAlignment="Center"/>
                                                <Border Grid.Column="1"
                                                    Width="160"
                                                    Height="28"
                                                    HorizontalAlignment="Left"
                                                    Background="#E8F1FF"
                                                    CornerRadius="5">

                                                    <Grid>

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Button x:Name="AutoModeButton"
                                                                Grid.Column="0"
                                                                Margin="2"
                                                                FontSize="15"
                                                                Content="AUTO"
                                                                Style="{StaticResource ModeButtonStyle}"
                                                                Click="AutoModeButton_Click"/>
                                                        <Button x:Name="ManualModeButton"
                                                            Grid.Column="1"
                                                            Margin="2"
                                                            Content="MANUAL"
                                                                FontSize="15"
                                                            Style="{StaticResource ModeButtonStyle}"
                                                            Click="ManualModeButton_Click"/>
                                                    </Grid>

                                                </Border>
                                            </Grid>

                                            <!-- DEFROST MODE -->

                                            <Grid Grid.Row="2">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="190"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>


                                                <!-- TITLE -->

                                                <TextBlock Grid.Column="0"
                                                           Text="Defrost Mode"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="#374151"
                                                           VerticalAlignment="Center"/>
                                                <!-- CHECKBOX + STATUS -->
                                                <Border Grid.Column="1"
                                                        Width="150"
                                                        Height="28"
                                                        HorizontalAlignment="Left"
                                                        Background="#E8F1FF"
                                                        CornerRadius="5">
                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                        <CheckBox x:Name="DefrostModeCheckBox"
                                                                  VerticalAlignment="Center"
                                                                  Checked="DefrostModeCheckBox_Checked"
                                                                  Unchecked="DefrostModeCheckBox_Unchecked"
                                                                  Cursor="Hand">
                                                            <CheckBox.LayoutTransform>
                                                                <ScaleTransform ScaleX="1.1"
                                                                                ScaleY="1.1"/>
                                                            </CheckBox.LayoutTransform>
                                                        </CheckBox>

                                                        <TextBlock x:Name="DefrostModeText"
                                                                   Text="MANUAL"
                                                                   Margin="7,0,0,0"
                                                                   FontSize="15"
                                                                   FontWeight="Bold"
                                                                   Foreground="#6B7280"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="White"
                                    BorderBrush="#DDE3EA"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Margin="0,0,0,10">

                                    <StackPanel>
                                        <Border Style="{StaticResource SectionHeaderStyle}">
                                            <TextBlock Text="VALVE CONTROL"
                                                       FontSize="16"
                                                   Style="{StaticResource SectionHeaderTextStyle}"/>
                                        </Border>
                                        <Grid Margin="15,6,15,8">

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="40"/>
                                                <RowDefinition Height="40"/>
                                                <RowDefinition Height="40"/>
                                                <RowDefinition Height="40"/>
                                            </Grid.RowDefinitions>
                                            <!-- LIQUID -->
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                       Text="Liquid Solenoid Valve"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="#374151"
                                                       VerticalAlignment="Center"/>
                                                <Border Grid.Column="1"
                                                    Width="150"
                                                    Height="27"
                                                    Background="#E8F1FF"
                                                    CornerRadius="5">

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Button x:Name="LiquidValveOpenButton"
                                                            Grid.Column="0"
                                                            Margin="2"
                                                            Content="OPEN"
                                                                FontSize="15"
                                                            Style="{StaticResource ValveButtonStyle}"
                                                            Click="LiquidValveOpenButton_Click"/>

                                                        <Button x:Name="LiquidValveCloseButton"
                                                            Grid.Column="1"
                                                            Margin="2"
                                                                FontSize="15"
                                                            Content="CLOSE"
                                                            Style="{StaticResource ValveButtonStyle}"
                                                            Click="LiquidValveCloseButton_Click"/>

                                                    </Grid>
                                                </Border>
                                            </Grid>
                                            <!-- SUCTION -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                       Text="Suction Solenoid Valve"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="#374151"
                                                       VerticalAlignment="Center"/>
                                                <Border Grid.Column="1"
                                                    Width="150"
                                                    Height="27"
                                                    Background="#E8F1FF"
                                                    CornerRadius="5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button x:Name="SuctionValveOpenButton"
                                                            Grid.Column="0"
                                                            Margin="2"
                                                            Content="OPEN"
                                                                FontSize="15"
                                                            Style="{StaticResource ValveButtonStyle}"
                                                            Click="SuctionValveOpenButton_Click"/>

                                                        <Button x:Name="SuctionValveCloseButton"
                                                            Grid.Column="1"
                                                            Margin="2"
                                                                FontSize="15"
                                                            Content="CLOSE"
                                                            Style="{StaticResource ValveButtonStyle}"
                                                            Click="SuctionValveCloseButton_Click"/>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                            <!-- HOT GAS RETURN -->
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                       Text="Hot Gas Return Valve"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="#374151"
                                                       VerticalAlignment="Center"/>
                                                <Border Grid.Column="1"
                                                    Width="150"
                                                    Height="27"
                                                    Background="#E8F1FF"
                                                    CornerRadius="5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button x:Name="HotGasReturnOpenButton"
                                                            Grid.Column="0"
                                                            Margin="2"
                                                            Content="OPEN"
                                                                FontSize="15"
                                                            Style="{StaticResource ValveButtonStyle}"
                                                            Click="HotGasReturnOpenButton_Click"/>
                                                        <Button x:Name="HotGasReturnCloseButton"
                                                            Grid.Column="1"
                                                            Margin="2"
                                                            Content="CLOSE"
                                                                FontSize="15"
                                                            Style="{StaticResource ValveButtonStyle}"
                                                            Click="HotGasReturnCloseButton_Click"/>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                            <!-- HOT GAS SOLENOID -->
                                            <Grid Grid.Row="3">
                                                <Grid.ColumnDefinitions>
