<Window x:Class="WPFSCADA.PopUps.NumericValueDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Width="340"
        Height="200"
        WindowStartupLocation="CenterOwner">
    <Border Margin="8"
            Background="#F5F7FA"
            CornerRadius="10"
            BorderBrush="#D9E0E7"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16"
                              ShadowDepth="3"
                              Opacity="0.22"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- HEADER -->
            <Border Grid.Row="0"
                    Background="#374151"
                    CornerRadius="10,10,0,0">
                <Grid>
                    <TextBlock x:Name="TitleText"
                               Text="UNIT NAME"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <Button Width="28"
                            Height="28"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Content="✕"
                            FontSize="13"
                            Foreground="White"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background"
                                        Value="Transparent"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                                <Setter Property="BorderThickness"
                                        Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="#4B5563"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
            <!-- CONTENT -->
            <Grid Grid.Row="1" Margin="15,15,15,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="45"/>
                </Grid.RowDefinitions>
                <!-- VALUE INPUT -->
                <StackPanel Grid.Row="0"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                    <!-- PARAMETER TITLE -->
                    <TextBlock x:Name="ParameterTitleText"
                   Text="TITLE"
                   Width="115"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#374151"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="0,0,8,0"/>
                    <!-- VALUE -->
                    <TextBox x:Name="ValueTextBox"
                 Width="100"
                 Height="34"
                 FontSize="17"
                 FontWeight="SemiBold"
                 HorizontalContentAlignment="Center"
                 VerticalContentAlignment="Center"
                 Padding="5"
                 BorderBrush="#9CA3AF"
                 BorderThickness="1"/>
                    <!-- UNIT -->
                    <TextBlock x:Name="InputUnitText"
                   Margin="7,0,0,0"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="#374151"
                   VerticalAlignment="Center"/>
                </StackPanel>
                <!-- BUTTONS -->
                <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                    <!-- SET -->
                    <Button Width="90"
                Height="30"
                Margin="4"
                Content="SET"
                FontSize="13"
                FontWeight="Bold"
                Foreground="White"
                Background="#1E73E8"
                BorderThickness="0"
                Cursor="Hand"
                Click="SetButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                            CornerRadius="5">
                                    <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- CANCEL -->
                    <Button Width="90"
                Height="30"
                Margin="4"
                Content="CANCEL"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="#4B5563"
                Background="#E5E7EB"
                BorderThickness="0"
                Cursor="Hand"
                Click="CancelButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                            CornerRadius="5">
                                    <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>