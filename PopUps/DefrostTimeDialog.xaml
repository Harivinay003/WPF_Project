<Window x:Class="WPFSCADA.PopUps.DefrostTimeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Width="320"
        Height="230"
        WindowStartupLocation="CenterOwner">
    <Border Margin="8"
            Background="#F5F7FA"
            CornerRadius="10"
            BorderBrush="#D9E0E7"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16"
                              ShadowDepth="3"
                              Opacity="0.22"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Background="#374151"
                    CornerRadius="10,10,0,0">
                <Grid>
                    <TextBlock x:Name="CycleTitleText"
                               Text="CYCLE 1"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <Button Width="28"
                            Height="28"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Content="✕"
                            FontSize="13"
                            Foreground="White"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background"
                                        Value="Transparent"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                                <Setter Property="BorderThickness"
                                        Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="#4B5563"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
            <Grid Grid.Row="1"
                  Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="35"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <TextBlock Text="Hours"
                               Width="90"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#374151"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="HoursTextBox"
                             Width="80"
                             Height="30"
                             Text="00"
                             MaxLength="2"
                             FontSize="15"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <TextBlock Text="Minutes"
                               Width="90"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#374151"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="MinutesTextBox"
                             Width="80"
                             Height="30"
                             Text="00"
                             MaxLength="2"
                             FontSize="15"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button Width="90"
                            Height="27"
                            Margin="4"
                            Content="SET"
                            FontSize="15"
                            FontWeight="Bold"
                            Foreground="White"
                            Background="#1E73E8"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="SetButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                     CornerRadius="5">
                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Width="90"
                            Height="27"
                            Margin="4"
                            Content="CANCEL"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="#4B5563"
                            Background="#E5E7EB"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CancelButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="5">
                                    <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>               
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>