    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- Reusable labeled toggle style (works with local:LabeledToggleButton) -->
        <Style x:Key="ToggleStyle" TargetType="{x:Type root:LabeledToggleButton}">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#FFD0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="root:LabeledToggleButton">
                        <Border x:Name="Root" CornerRadius="0" Background="#fff" SnapsToDevicePixels="True"
             BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- sliding thumb — use TranslateTransform for animation #1E73E8-->
                                <Border x:Name="Thumb" CornerRadius="0" Grid.Column="0" Background="{StaticResource PrimaryGreenBrush}">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="ThumbTransform" X="0" />
                                    </Border.RenderTransform>
                                </Border>
                                <!-- labels bound to the control's properties -->
                                <TextBlock Padding="2" x:Name="LeftLabel" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="DemiBold" Foreground="White" Text="{TemplateBinding OffText}"/>
                                <TextBlock Padding="2" x:Name="RightLabel" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="DemiBold" Foreground="#333" Text="{TemplateBinding OnText}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#e7f6ff"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="LeftLabel" Property="Foreground" Value="#333"/>
                                <Setter TargetName="RightLabel" Property="Foreground" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X" To="49" Duration="0:0:0.12" FillBehavior="HoldEnd" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.12" FillBehavior="HoldEnd" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
