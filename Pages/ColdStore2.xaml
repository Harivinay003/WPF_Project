<Page x:Class="WPFSCADA.Pages.ColdStore2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFSCADA.Pages"
      xmlns:helpers="clr-namespace:WPFSCADA.Helpers"
      xmlns:controls="clr-namespace:WPFSCADA.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="1050" d:DesignWidth="1800"
      Title="Cold Store 2">
    <Border BorderBrush="#FFCCCCCC" BorderThickness="1">
        <Grid Background="{StaticResource PageBackgroundBrush}">
            <Viewbox Stretch="Uniform">
                <Canvas Width="1800" Height="1050">
                    <StackPanel Orientation="Vertical">
                        <Canvas Width="1800" Height="180" Background="White" Panel.ZIndex="0">
                            <Button
x:Name="ConfigurationButton"
Content="Configuration Mode"
Width="160"
Height="40"
                            Canvas.Left="1600"
Click="ConfigurationButton_Click"/>
                            <Grid Canvas.Top="8" Canvas.Left="0" 
                                Height="80" Width="1800"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50*"/>
                                    <ColumnDefinition Width="50*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource DashboardCard}"
                                    Width="308" Height="70"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image Source="/WPFSCADA;component/images/cold.png" Width="86" Height="61" Opacity="0.6"/>
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="Cold Store - 2 Temperature" Foreground="#000" FontSize="16" FontWeight="DemiBold"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock x:Name="cs1Temp" FontSize="28" helpers:TagProperties.ConfigKey="ColdStoreTemp" FontWeight="DemiBold" Foreground="Green"
                                                   Text="{Binding ColdStoreTemp, RelativeSource={RelativeSource AncestorType=Page}, StringFormat={}{0:N2}}"/>
                                                <TextBlock Text=" °C" FontSize="18" Foreground="Black" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource DashboardCard}"
        Width="270" Height="70"
        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image Source="/WPFSCADA;component/images/target.png" Width="87" Height="51" Opacity="0.6"/>
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="Set Temperature" Foreground="Black" FontSize="20" FontWeight="DemiBold" HorizontalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock x:Name="setTemp" helpers:TagProperties.ConfigKey="SetPoint" FontSize="28" FontWeight="DemiBold" Foreground="{StaticResource PrimaryBlueBrush}"
                                                   Text="{Binding SetPoint, RelativeSource={RelativeSource AncestorType=Page}, StringFormat={}{0:N2}}" HorizontalAlignment="Center"/>
                                                <TextBlock Text=" °C" FontSize="18" Foreground="Black" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>



                            </Grid>
                            <Path Stroke="Red" StrokeThickness="6" Panel.ZIndex="5">
                                <!--<Path.Effect>
                            <DropShadowEffect ShadowDepth="5" BlurRadius="5" />
                        </Path.Effect>-->
                                <Path.Data>
                                    <PathGeometry>
                                        <PathFigure StartPoint="0,100">
                                            <LineSegment Point="1800,100" />
                                        </PathFigure>
                                        <!--<PathFigure StartPoint="50,100">
                                    <LineSegment Point="50,190" />
                                </PathFigure>
                                <PathFigure StartPoint="930,100">
                                    <LineSegment Point="930,168" />
                                </PathFigure>-->
                                    </PathGeometry>
                                </Path.Data>
                            </Path>
                            <Path Stroke="DodgerBlue" StrokeThickness="6" Panel.ZIndex="4">
                                <!--<Path.Effect>
                            <DropShadowEffect ShadowDepth="5" BlurRadius="5" />
                        </Path.Effect>-->
                                <Path.Data>
                                    <PathGeometry>
                                        <PathFigure StartPoint="0,130">
                                            <LineSegment Point="1800,130" />
                                        </PathFigure>
                                        <!--<PathFigure StartPoint="93,130">
                                    <LineSegment Point="93,168" />
                                </PathFigure>
                                <PathFigure StartPoint="973,130">
                                    <LineSegment Point="973,168" />
                                </PathFigure>-->
                                    </PathGeometry>
                                </Path.Data>
                            </Path>
                            <Path Stroke="Orange" StrokeThickness="6">
                                <!--<Path.Effect>
                            <DropShadowEffect ShadowDepth="5" BlurRadius="5" />
                        </Path.Effect>-->
                                <Path.Data>
                                    <PathGeometry>
                                        <PathFigure StartPoint="0,160">
                                            <LineSegment Point="1800,160" />
                                        </PathFigure>
                                        <!--<PathFigure StartPoint="71,160">
                                    <LineSegment Point="71,168" />
                                </PathFigure>
                                <PathFigure StartPoint="951,160">
                                    <LineSegment Point="951,168" />
                                </PathFigure>-->
                                    </PathGeometry>
                                </Path.Data>
                            </Path>
                        </Canvas>
                        <Grid Background="White" Width="1800" Height="870" Panel.ZIndex="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="45*"/>
                                <ColumnDefinition Width="45*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="1" BorderBrush="#666" BorderThickness="0" CornerRadius="5" >
                                <controls:ColdStoreUnit x:Name="CS2U1"
                                                        ColdStoreName="COLDSTORE UNIT - 3"/>
                            </Border>
                            <Border Grid.Column="2" BorderBrush="#666" BorderThickness="0" CornerRadius="5" >
                                <controls:ColdStoreUnit x:Name="CS2U2"
                                                        ColdStoreName="COLDSTORE UNIT - 4"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Canvas>
            </Viewbox>
        </Grid>
    </Border>
</Page>
