<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Primary -->
    <Color x:Key="PrimaryBlue">#0D5CC0</Color>
    <Color x:Key="PrimaryGreen">#16A34A</Color>
    <Color x:Key="PrimaryOrange">#F97316</Color>
    <Color x:Key="PrimaryRed">#DC2626</Color>

    <!-- Background -->
    <Color x:Key="PageBackground">#F4F6F9</Color>
    <Color x:Key="CardBackground">#f2f2f2</Color>

    <!-- Text -->
    <Color x:Key="TitleText">#1E293B</Color>
    <Color x:Key="BodyText">#475569</Color>

    <!-- Border -->
    <Color x:Key="BorderColor">#E2E8F0</Color>
    
</ResourceDictionary>