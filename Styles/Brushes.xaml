<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PrimaryBlueBrush"
                 Color="{StaticResource PrimaryBlue}"/>

    <SolidColorBrush x:Key="PrimaryGreenBrush"
                 Color="{StaticResource PrimaryGreen}"/>

    <SolidColorBrush x:Key="PrimaryOrangeBrush"
                 Color="{StaticResource PrimaryOrange}"/>

    <SolidColorBrush x:Key="PrimaryRedBrush"
                 Color="{StaticResource PrimaryRed}"/>

    <SolidColorBrush x:Key="PageBackgroundBrush"
                 Color="{StaticResource PageBackground}"/>

    <SolidColorBrush x:Key="CardBackgroundBrush"
                 Color="{StaticResource CardBackground}"/>

    <SolidColorBrush x:Key="BorderBrush"
                 Color="{StaticResource BorderColor}"/>

    <SolidColorBrush x:Key="TitleBrush"
                 Color="{StaticResource TitleText}"/>

    <SolidColorBrush x:Key="BodyBrush"
                 Color="{StaticResource BodyText}"/>
</ResourceDictionary>