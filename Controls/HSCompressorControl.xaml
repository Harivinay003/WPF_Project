<UserControl x:Class="WPFSCADA.Controls.HSCompressorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFSCADA.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="400">
    <Grid>
        <Viewbox Stretch="Uniform">
            <Border Style="{StaticResource DashboardCard}" Margin="3">
                <Canvas Width="405" Height="400">
                    <Grid Width="400" Height="400">
                        <!-- ROWS-->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="6*"/>
                            <RowDefinition Height="35*"/>
                            <RowDefinition Height="30*"/>
                            <RowDefinition Height="30*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="33*"/>
                            <ColumnDefinition Width="33*"/>
                            <ColumnDefinition Width="33*"/>
                        </Grid.ColumnDefinitions>
                        <!--1st row-->
                        <Grid Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4" Panel.ZIndex="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="75*"/>
                                    <ColumnDefinition Width="25*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" HorizontalAlignment="Right" Panel.ZIndex="15"
           Background="{StaticResource CardBackgroundBrush}"
           Text="{Binding CompressorName, RelativeSource={RelativeSource AncestorType=UserControl}}"
           FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueBrush}">
                                    <TextBlock.Effect>
                                        <DropShadowEffect ShadowDepth="1" BlurRadius="3" Color="#000" Opacity="0.7"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <Border Grid.Column="1" Width="80" Height="20" Margin="3,2,3,2" HorizontalAlignment="Right"
        Background="#16A34A" CornerRadius="10">
                                    <TextBlock Text="RUNNING" Foreground="White" FontSize="12"
               FontWeight="SemiBold" HorizontalAlignment="Center"
               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Grid>
                        <!--2nd row-->
                        <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3">
                            <Canvas Height="132" Width="400">
                                <!--compressor image-->
                                <Image Width='200' Canvas.Left="5" Canvas.Top="0"
                                       Source="/WPFSCADA;component/images/Compressor_Bold.png"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="10"
                                        MouseLeftButtonUp="CompressorImage_MouseLeftButtonUp"/>
                                <!-- TOP MOTOR -->
                                <Image x:Name="TopMotor"
                                       Width="45"
                                       Canvas.Left="109"
                                       Canvas.Top="25"
                                       Panel.ZIndex="5"
                                       RenderTransformOrigin="0.46,0.527">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Source" Value="/WPFSCADA;component/images/Compre_Top_Motor_Green.png"/>
                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding CompressorTopMotor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Value="True">
                                                    <Setter Property="Source"
                                                            Value="/WPFSCADA;component/images/Compre_Top_Motor_Green.png"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <!-- BOTTOM MOTOR -->
                                <Image x:Name="BottomMotor"
                                       Width="36"
                                       Canvas.Left="158"
                                       Canvas.Top="100"
                                       Panel.ZIndex="5"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Source"
                                                    Value="/WPFSCADA;component/Assets/Compre_down_Motor_Green.png"/>
                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding CompressorBottomMotor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Value="True">
                                                    <Setter Property="Source"
                                                            Value="/WPFSCADA;component/Assets/Compre_down_Motor_Green.png"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <!-- RED PIPE  -->
                                <Path Name="mainRedPath" Stroke="Red" StrokeThickness="3" Panel.ZIndex="5">
                                    <Path.Data>
                                        <PathGeometry>
                                            <PathFigure StartPoint="165,-64">
                                                <LineSegment Point="165,42"/>
                                                <QuadraticBezierSegment Point1="165,49" Point2="175,49"/>
                                            </PathFigure>
                                        </PathGeometry>
                                    </Path.Data>
                                </Path>
                                <!-- BLUE PIPE  -->
                                <Path Name="mainbluePath" Stroke="DodgerBlue" StrokeThickness="3" Panel.ZIndex="5">
                                    <Path.Data>
                                        <PathGeometry>
                                            <PathFigure StartPoint="24,-44">
                                                <LineSegment Point="24,8"/>

                                            </PathFigure>
                                        </PathGeometry>
                                    </Path.Data>
                                </Path>
                                
                                <!-- Summary -->
                                <Border Style="{StaticResource DashboardCard}" Canvas.Top="5" Canvas.Left="245"
                                        Width="145" Height="130"
                                        HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Grid Margin="3">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="30*"/>
                                            <RowDefinition Height="2*"/>
                                            <RowDefinition Height="30*"/>
                                            <RowDefinition Height="2*"/>
                                            <RowDefinition Height="34*"/>
                                        </Grid.RowDefinitions>
                                        <!--RUN HOURS -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="25*"/>
                                                <ColumnDefinition Width="75*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🕒" FontSize="18" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="RUN HOURS" FontSize="8" FontWeight="DemiBold" HorizontalAlignment="Left"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                    <TextBlock x:Name="runHoursTextBlock" Text="{Binding RunHours}" FontSize="14" FontWeight="DemiBold"/>
                                                    <TextBlock Opacity="0.7" x:Name="runHoursUnitTextBlock" Text="hrs" FontSize="8" FontWeight="SemiBold"/>
                                                    <TextBlock Margin="4,0,0,0" x:Name="runHoursMinutesTextBlock" Text="{Binding RunMinutes}" FontSize="14" FontWeight="DemiBold"/>
                                                    <TextBlock Opacity="0.7" x:Name="runHoursMinutesUnitTextBlock" Text="mins" FontSize="8" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                        <!-- Divider -->
                                        <Border Grid.Row="1" Background="Black" Opacity="0.8" Height="2"/>
                                        <!--OIL PUMP-->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="25*"/>
                                                <ColumnDefinition Width="75*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="💧" FontSize="18"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="OIL PUMP HOURS" FontWeight="DemiBold" FontSize="8"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                    <TextBlock x:Name="oilPumpHoursTextBlock" Text="{Binding OilPumpHours}" FontSize="14" FontWeight="DemiBold"/>
                                                    <TextBlock Opacity="0.7" x:Name="oilPumpHoursUnitTextBlock" Text="hrs" FontSize="8" FontWeight="SemiBold"/>
                                                    <TextBlock Margin="4,0,0,0" x:Name="oilPumpMinutesTextBlock" Text="{Binding OilPumpMinutes}" FontSize="14" FontWeight="DemiBold"/>
                                                    <TextBlock Opacity="0.7" x:Name="oilPumpMinutesUnitTextBlock" Text="mins" FontSize="8" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                        <!-- Divider -->
                                        <Border Grid.Row="3" Background="Black" Opacity="0.8" Height="2"/>
                                        <!--SLIDE VALVE -->
                                        <Grid Grid.Row="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="25*"/>
                                                <ColumnDefinition Width="75*"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Valve Icon -->
                                            <Viewbox Width="20" Height="22">
                                                <Canvas Width="24" Height="24">
                                                    <Ellipse Width="20" Height="20" Stroke="#333" 
                                                             StrokeThickness="1.5" Canvas.Left="2" Canvas.Top="2"/>
                                                    <Line X1="12" Y1="0" X2="12" Y2="24" 
                                                          Stroke="#333" StrokeThickness="1.5"/>
                                                    <Line X1="0" Y1="12" X2="24" Y2="12"
                                                          Stroke="#333" StrokeThickness="1.5"/>
                                                </Canvas>
                                            </Viewbox>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="SLIDE VALVE POSITION" FontWeight="DemiBold" FontSize="8"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock x:Name="slideValvePositionTextBlock" Text="{Binding SlideValvePercent}" FontSize="14" FontWeight="DemiBold"/>
                                                    <TextBlock Text="%" Margin="4,0,0,0" FontSize="14"/>
                                                </StackPanel>
                                                <!-- Progress -->
                                                <Border Height="8" Margin="0,2,0,0" Background="#c2c2c2" 
                                                        CornerRadius="3" BorderBrush="#999" BorderThickness="1">
                                                    <Grid>
                                                        <Border x:Name="SlideValveFill" Width="0" HorizontalAlignment="Left"
                                                                Background="#1565C0" CornerRadius="3"/>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Canvas>
                        </Grid>
                        <!--3rd row-->
                        <Grid Grid.Row="2" Grid.Column="1" Grid.RowSpan="2" >
                            <Border Style="{StaticResource ParamerCardStyle}" Margin="0,5,0,5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="20"/>
                                        <RowDefinition Height="75*"/>
                                    </Grid.RowDefinitions>
                                    <!--header-->
                                    <Border Grid.Row="0" CornerRadius="8,8,0,0"
                                            Background="{StaticResource PrimaryBlueBrush}">
                                        <TextBlock FontSize="10" FontWeight="DemiBold" 
                                                   Text="PARAMETERS" Foreground="White" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Grid Grid.Row="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70*"/>
                                                <ColumnDefinition Width="15*"/>
                                                <ColumnDefinition Width="12*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="9*"/>
                                                <RowDefinition Height="1*"/>
                                                <RowDefinition Height="9*"/>
                                                <RowDefinition Height="1*"/>
                                                <RowDefinition Height="9*"/>
                                                <RowDefinition Height="1*"/>
                                                <RowDefinition Height="9*"/>
                                                <RowDefinition Height="1*"/>
                                                <RowDefinition Height="9*"/>
                                                <RowDefinition Height="1*"/>
                                                <RowDefinition Height="9*"/>
                                                <RowDefinition Height="1*"/>
                                                <RowDefinition Height="9*"/>
                                                <RowDefinition Height="1*"/>
                                                <RowDefinition Height="9*"/>
                                                <RowDefinition Height="1*"/>
                                                <RowDefinition Height="9*"/>
                                                <RowDefinition Height="1*"/>
                                                <RowDefinition Height="9*"/>
                                            </Grid.RowDefinitions>
                                            <!--ROW 0-->
                                            <TextBlock Grid.Row="0" Margin="2,0,0,0" Grid.Column="0" Text="Suction Pressure" FontSize="8" FontWeight="DemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1"  Text="{Binding SuctionPressure, StringFormat={}{0:N1}}" Foreground="Green" FontSize="10"
                                                       FontWeight="DemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text=" bar" Foreground="Black" FontSize="7"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                            <!--DIVIDER-->
                                            <Border Grid.Row="1" Grid.ColumnSpan="3" Background="Black" Opacity="0.5" Height="1"/>
                                            <!--ROW 2-->
                                            <TextBlock Grid.Row="2" Margin="2,0,0,0" Grid.Column="0" Text="Suction Temperature" FontSize="8" FontWeight="DemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SuctionTemperature, StringFormat={}{0:N1}}" Foreground="Green" FontSize="10"
                                                       FontWeight="DemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="°C" Foreground="Black" FontSize="7"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                            <!--DIVIDER-->
                                            <Border Grid.Row="3" Grid.ColumnSpan="3" Background="Black" Opacity="0.5" Height="1"/>
                                            <!--ROW 4-->
                                            <TextBlock Grid.Row="4" Margin="2,0,0,0" Grid.Column="0" Text="Discharge Pressure" FontSize="8" FontWeight="DemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DischargePressure, StringFormat={}{0:N1}}" Foreground="Green" FontSize="10"
                                                       FontWeight="DemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="4" Grid.Column="2" Text=" bar" Foreground="Black" FontSize="7"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                            <!--DIVIDER-->
                                            <Border Grid.Row="5" Grid.ColumnSpan="3" Background="Black" Opacity="0.5" Height="1"/>
                                            <!--ROW 6-->
                                            <TextBlock Grid.Row="6" Margin="2,0,0,0" Grid.Column="0" Text="Discharge Temperature" FontSize="8" FontWeight="DemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding DischargeTemperature, StringFormat={}{0:N1}}" Foreground="Green" FontSize="10"
                                                       FontWeight="DemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="6" Grid.Column="2" Text="°C" Foreground="Black" FontSize="7"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                            <!--DIVIDER-->
                                            <Border Grid.Row="7" Grid.ColumnSpan="3" Background="Black" Opacity="0.5" Height="1"/>
                                            <!--ROW 8-->
                                            <TextBlock Grid.Row="8" Margin="2,0,0,0" Grid.Column="0" Text="Oil Pressure" FontSize="8" FontWeight="DemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding OilPressure, StringFormat={}{0:N1}}" Foreground="Green" FontSize="10"
                                                       FontWeight="DemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="8" Grid.Column="2" Text=" bar" Foreground="Black" FontSize="7"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                            <!--DIVIDER-->
                                            <Border Grid.Row="9" Grid.ColumnSpan="3" Background="Black" Opacity="0.5" Height="1"/>
                                            <!--ROW 10-->
                                            <TextBlock Grid.Row="10" Margin="2,0,0,0" Grid.Column="0" Text="Oil Temperature" FontSize="8" FontWeight="DemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding OilTemperature, StringFormat={}{0:N1}}" Foreground="Green" FontSize="10"
                                                       FontWeight="DemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="10" Grid.Column="2" Text="°C" Foreground="Black" FontSize="7"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                            <!--DIVIDER-->
                                            <Border Grid.Row="11" Grid.ColumnSpan="3" Background="Black" Opacity="0.5" Height="1"/>
                                            <!--ROW 12-->
                                            <TextBlock Grid.Row="12" Margin="2,0,0,0" Grid.Column="0" Text="Oil Pressure BP" FontSize="8" FontWeight="DemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding OilPressureBP, StringFormat={}{0:N1}}" Foreground="Green" FontSize="10"
                                                       FontWeight="DemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="12" Grid.Column="2" Text=" bar" Foreground="Black" FontSize="7"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                            <!--DIVIDER-->
                                            <Border Grid.Row="13" Grid.ColumnSpan="3" Background="Black" Opacity="0.5" Height="1"/>
                                            <!--ROW 14-->
                                            <TextBlock Grid.Row="14" Margin="2,0,0,0" Grid.Column="0" Text="Delta FP" FontSize="8" FontWeight="DemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="14" Grid.Column="1" Text="{Binding DeltaFP, StringFormat={}{0:N1}}" Foreground="Green" FontSize="10"
                                                       FontWeight="DemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="14" Grid.Column="2" Text=" bar" Foreground="Black" FontSize="7"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                            <!--DIVIDER-->
                                            <Border Grid.Row="15" Grid.ColumnSpan="3" Background="Black" Opacity="0.5" Height="1"/>
                                            <!--ROW 16-->
                                            <TextBlock Grid.Row="16" Margin="2,0,0,0" Grid.Column="0" Text="Delta OP" FontSize="8" FontWeight="DemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="16" Grid.Column="1" Text="{Binding DeltaOP, StringFormat={}{0:N1}}" Foreground="Green" FontSize="10"
                                                       FontWeight="DemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="16" Grid.Column="2" Text=" bar" Foreground="Black" FontSize="7"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                            <!--DIVIDER-->
                                            <Border Grid.Row="17" Grid.ColumnSpan="3" Background="Black" Opacity="0.5" Height="1"/>
                                            <!--ROW 18-->
                                            <TextBlock Grid.Row="18" Margin="2,0,0,0" Grid.Column="0" Text="Oil SEP Temperature" FontSize="8" FontWeight="DemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="18" Grid.Column="1" Text="{Binding OilSEPTemperature, StringFormat={}{0:N1}}" Foreground="Green" FontSize="10"
                                                       FontWeight="DemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="18" Grid.Column="2" Text="°C" Foreground="Black" FontSize="7"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                        <!--set points-->
                        <Grid Grid.Row="2" Grid.Column="2">
                            <Border Style="{StaticResource ParamerCardStyle}" Margin="5,5,0,5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="20"/>
                                        <RowDefinition Height="75*"/>
                                    </Grid.RowDefinitions>
                                    <!--header-->
                                    <Border Grid.Row="0" CornerRadius="8,8,0,0"
                                            Background="{StaticResource PrimaryBlueBrush}">
                                        <TextBlock FontSize="10" FontWeight="DemiBold" 
                                                   Text="SET POINTS" Foreground="White" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="55*"/>
                                            <ColumnDefinition Width="20*"/>
                                            <ColumnDefinition Width="13*"/>
                                            <ColumnDefinition Width="12*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="20*"/>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="20*"/>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="20*"/>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="20*"/>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="20*"/>
                                            <RowDefinition Height="1*"/>
                                        </Grid.RowDefinitions>
                                        <!--ROW 0-->
                                        <TextBlock Grid.Row="0" Margin="4,0,0,0" Grid.Column="0" Text="CC Set Point" FontWeight="DemiBold" FontSize="8" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CCSetPoint}" Foreground="Green" FontSize="10"
                                                    FontWeight="DemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text=" bar" Foreground="Black" FontSize="7"
                                                    FontWeight="DemiBold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        <Button Grid.Row="0" Grid.Column="3" HorizontalAlignment="Left" Width="10" Height="13"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                 Click="CCSetPointEdit_Click">
                                            <TextBlock Text="✎" FontSize="8" Foreground="#1565C0"/>
                                        </Button>
                                        <!--DIVIDER-->
                                        <Border Grid.Row="1" Grid.ColumnSpan="4" Background="Black" Opacity="0.5" Height="1"/>
                                        <!--ROW 2-->
                                        <TextBlock Grid.Row="2" Margin="4,0,0,0" Grid.Column="0" Text="SP Alarm" FontWeight="DemiBold" FontSize="8" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SPAlarm}" Foreground="Green" FontSize="10"
                                                    FontWeight="DemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text=" bar" Foreground="Black" FontSize="7"
                                                    FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        <Button Grid.Row="2" Grid.Column="3" HorizontalAlignment="Left" Width="10" Height="13"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                Click="SPAlarmEdit_Click">
                                            <TextBlock Text="✎" FontSize="8" Foreground="#1565C0"/>
                                        </Button>
                                        <!--DIVIDER-->
                                        <Border Grid.Row="3" Grid.ColumnSpan="4" Background="Black" Opacity="0.5" Height="1"/>
                                        <!--ROW 4-->
                                        <TextBlock Grid.Row="4" Margin="4,0,0,0" Grid.Column="0" Text="SP Cutout" FontWeight="DemiBold" FontSize="8" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SPCutout}" Foreground="Green" FontSize="10"
                                                    FontWeight="DemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="4" Grid.Column="2" Text=" bar" Foreground="Black" FontSize="7"
                                                    FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        <Button Grid.Row="4" HorizontalAlignment="Left" Grid.Column="3" Width="10" Height="13"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                Click="SPCutoutEdit_Click">
                                            <TextBlock Text="✎" FontSize="8" Foreground="#1565C0"/>
                                        </Button>
                                        <!--DIVIDER-->
                                        <Border Grid.Row="5" Grid.ColumnSpan="4" Background="Black" Opacity="0.5" Height="1"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                        <!--status-->
                        <Grid Grid.Row="2" Grid.Column="3">
                            <Border Style="{StaticResource ParamerCardStyle}" Margin="5,5,0,5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="20"/>
                                        <RowDefinition Height="75*"/>
                                    </Grid.RowDefinitions>
                                    <!--header-->
                                    <Border Grid.Row="0" CornerRadius="8,8,0,0"
                                            Background="{StaticResource PrimaryBlueBrush}">
                                        <TextBlock FontSize="10" FontWeight="DemiBold" 
                                                   Text="STATUS" Foreground="White" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60*"/>
                                            <ColumnDefinition Width="30*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="20*"/>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="20*"/>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="20*"/>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="20*"/>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="20*"/>
                                            <RowDefinition Height="1*"/>
                                        </Grid.RowDefinitions>
                                        <!--row 0-->
                                        <TextBlock Grid.Row="0" Margin="4,0,0,0" Grid.Column="0" Text="Slide Valve Status" FontSize="8" FontWeight="DemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="0" Margin="4,0,0,0" Grid.Column="1" Text="{Binding SlideValveStatus}" FontSize="8" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <!--DIVIDER-->
                                        <Border Grid.Row="1" Grid.ColumnSpan="4" Background="Black" Opacity="0.5" Height="1"/>
                                        <!--row 2-->
                                        <TextBlock Grid.Row="2" Margin="4,0,0,0" Grid.Column="0" Text="Comp Start/Stop" FontSize="8" FontWeight="DemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="2" Margin="4,0,0,0" Grid.Column="1" Text="{Binding CompStartStop}" FontSize="8" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <!--DIVIDER-->
                                        <Border Grid.Row="3" Grid.ColumnSpan="4" Background="Black" Opacity="0.5" Height="1"/>
                                        <!--row 4-->
                                        <TextBlock Grid.Row="4" Margin="4,0,0,0" Grid.Column="0" Text="Comp Local/Remote" FontSize="8" FontWeight="DemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="4" Margin="4,0,0,0" Grid.Column="1" Text="{Binding CompLocalRemote}" FontSize="8" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <!--DIVIDER-->
                                        <Border Grid.Row="5" Grid.ColumnSpan="4" Background="Black" Opacity="0.5" Height="1"/>
                                        <!--row 6-->
                                        <TextBlock Grid.Row="6" Margin="4,0,0,0" Grid.Column="0" Text="Comp Auto/Manual" FontSize="8" FontWeight="DemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="6" Margin="4,0,0,0" Grid.Column="1" Text="{Binding CompAutoManual}" FontSize="8" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <!--DIVIDER-->
                                        <Border Grid.Row="7" Grid.ColumnSpan="4" Background="Black" Opacity="0.5" Height="1"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                        <!--electrical-->
                        <Grid Grid.Row="3" Grid.Column="2">
                            <Border Style="{StaticResource ParamerCardStyle}" Margin="5,5,0,5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="20"/>
                                        <RowDefinition Height="75*"/>
                                    </Grid.RowDefinitions>
                                    <!--header-->
                                    <Border Grid.Row="0" CornerRadius="8,8,0,0"
                                            Background="{StaticResource PrimaryBlueBrush}">
                                        <TextBlock FontSize="10" FontWeight="DemiBold" 
                                                   Text="ELECTRICAL" Foreground="White" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="55*"/>
                                            <ColumnDefinition Width="25*"/>
                                            <ColumnDefinition Width="20*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="20*"/>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="20*"/>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="20*"/>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="20*"/>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="20*"/>
                                            <RowDefinition Height="1*"/>
                                        </Grid.RowDefinitions>
                                        <!--ROW 0-->
                                        <TextBlock Grid.Row="0" Margin="4,0,0,0" Grid.Column="0" Text="Motor Current" FontWeight="DemiBold" FontSize="8" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MotorCurrent}" Foreground="Green" FontSize="10"
                        FontWeight="DemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text=" amps" Foreground="Black" FontSize="7"
                        FontWeight="DemiBold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        <!--DIVIDER-->
                                        <Border Grid.Row="1" Grid.ColumnSpan="4" Background="Black" Opacity="0.5" Height="1"/>
                                        <!--ROW 2-->
                                        <TextBlock Grid.Row="2" Margin="4,0,0,0" Grid.Column="0" Text="Motor Power" FontWeight="DemiBold" FontSize="8" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MotorPower}" Foreground="Green" FontSize="10"
                        FontWeight="DemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text=" kw" Foreground="Black" FontSize="7"
                        FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                                        <!--DIVIDER-->
                                        <Border Grid.Row="3" Grid.ColumnSpan="4" Background="Black" Opacity="0.5" Height="1"/>
                                        <!--ROW 4-->
                                        <TextBlock Grid.Row="4" Margin="4,0,0,0" Grid.Column="0" Text="Motor Speed" FontWeight="DemiBold" FontSize="8" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding MotorSpeed}" Foreground="Green" FontSize="10"
                        FontWeight="DemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="4" Grid.Column="2" Text=" rpm" Foreground="Black" FontSize="7"
                        FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                        <!--DIVIDER-->
                                        <Border Grid.Row="5" Grid.ColumnSpan="4" Background="Black" Opacity="0.5" Height="1"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                        <!--control-->
                        <Grid Grid.Row="3" Grid.Column="3">
                            <Border Style="{StaticResource ParamerCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="20"/>
                                        <RowDefinition Height="75*"/>
                                    </Grid.RowDefinitions>
                                    <!--header-->
                                    <Border Grid.Row="0" Background="{StaticResource PrimaryBlueBrush}" 
                CornerRadius="8,8,0,0">
                                        <TextBlock FontSize="10" FontWeight="DemiBold" Text="CONTROLS"
                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <!--content-->
                                    <Grid Grid.Row="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="40*"/>
                                                <RowDefinition Height="1*"/>
                                                <RowDefinition Height="40*"/>
                                                <RowDefinition Height="1*"/>
                                                <RowDefinition Height="10*"/>
                                                <RowDefinition Height="10*"/>
                                            </Grid.RowDefinitions>
                                            <!--start stop buttons-->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50*"/>
                                                    <ColumnDefinition Width="50*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- start-->
                                                <Button Grid.Column="0"  x:Name="StartButton1" Width="45" Background="#169C4A"
                            Style="{StaticResource ControlbuttonStyle}"  Click="StartButton1_Click">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock FontSize="10" Text="▶" Margin="0,0,3,0"/>
                                                        <TextBlock FontSize="8" Text="START" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <!-- stop-->
                                                <Button Grid.Column="1" Margin="2" x:Name="StopButton1" Width="45"
                            Style="{StaticResource ControlbuttonStyle}"   Click="StopButton1_Click" Background="#D62828">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock  FontSize="10" Text="■" Margin="0,0,3,0"/>
                                                        <TextBlock FontSize="8" Text="STOP" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <!--DIVIDER-->
                                            <Border Grid.Row="1" Grid.ColumnSpan="4" Background="Black" Opacity="0.5" Height="1"/>
                                            <!--alarm reset button-->
                                            <Grid Grid.Row="2">
                                                <Button x:Name="ResetButton1" Margin="2"
                                                        Style="{StaticResource roundedButtonStyle}" Width="70"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Content="Alarm RESET"
                                                         Click="ResetButton1_Click">
                                                </Button>
                                            </Grid>
                                            <!--DIVIDER-->
                                            <Border Grid.Row="3" Grid.ColumnSpan="4" Background="Black" Opacity="0.5" Height="1"/>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Canvas>
            </Border>
        </Viewbox>
    </Grid>
</UserControl>
