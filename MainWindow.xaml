<Window x:Class="WPFSCADA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFSCADA"
        mc:Ignorable="d"
        Title="SCADA Explorer - WPF" Width="1920" WindowStyle="None" WindowState="Maximized" Height="1080">

    <Window.Resources>
        <!-- Custom Button Style with Rounded Corners and Hover Effect -->
        
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10*" />
            <ColumnDefinition Width="90*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"  />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!-- Left navigation -->
        <StackPanel Grid.Row="1" Margin="1"  Grid.Column="0" Background="#0c3260" RenderTransformOrigin="0.5,0.5">
            
            <Button Name="scadaButton" 
                    Click="scadaButton_Click" 
                    Style="{StaticResource highlightMenuButtonStyle}">
                <!--<Button.Background>
                    <ImageBrush ImageSource="/images/but.png" Stretch="Fill"/>
                </Button.Background>-->
                <DockPanel Width="130">
                    <Image Source="/images/home.png" Margin="0,0,8,0" HorizontalAlignment="Left"/>
                    <TextBlock Text="Overview" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                </DockPanel>
            </Button>
            <!-- Graphics button: shows a dropdown of Pages on click -->
            <Button Name="graphicsButton" Style="{StaticResource menuButtonStyle}"
                    Click="graphicsButton_MouseEnter">

                <DockPanel Width="130">
                    <Image Source="/images/event.png" Margin="0,0,8,0" HorizontalAlignment="Left"/>
                    <TextBlock Text="Graphics" VerticalAlignment="Center" Margin="10,0,0,0" HorizontalAlignment="Left"/>
                </DockPanel>
            </Button>
            <Button Name="emsButton"
Style="{StaticResource menuButtonStyle}"
                    Click="emsButton_Click">
                <DockPanel Width="130">
                    <Image Source="/images/report.png" Margin="0,0,8,0" HorizontalAlignment="Left"/>
                    <TextBlock Text="Energy" VerticalAlignment="Center" Margin="10,0,0,0" HorizontalAlignment="Left"/>
                </DockPanel>
            </Button>
            <Button Name="usersButton"
                    Style="{StaticResource menuButtonStyle}"
                    Click="usersButton_Click">
                
                <DockPanel Width="130">
                    <Image Source="/images/report.png" Margin="0,0,8,0" HorizontalAlignment="Left"/>
                    <TextBlock Text="Reports" VerticalAlignment="Center" Margin="10,0,0,0" HorizontalAlignment="Left"/>
                </DockPanel>
            </Button>
            <Button Name="settingsButton" Style="{StaticResource menuButtonStyle}" Click="settingsButton_Click">
                
                <DockPanel Width="130">
                    <Image Source="/images/bell.png" Margin="0,0,8,0" HorizontalAlignment="Left"/>
                    <TextBlock Text="Alarms" VerticalAlignment="Center" Margin="10,0,0,0" HorizontalAlignment="Left"/>
                </DockPanel>
            </Button>
            <Button Name="reportsButton" Style="{StaticResource menuButtonStyle}"  Click="reportsButton_Click">
                
                <DockPanel Width="130">
                    <Image Source="/images/trending.png" Margin="0,0,8,0" HorizontalAlignment="Left"/>
                    <TextBlock Text="Trends" VerticalAlignment="Center" Margin="10,0,0,0" HorizontalAlignment="Left"/>
                </DockPanel>
            </Button>
            <Button Name="trendsBbutton" Style="{StaticResource menuButtonStyle}" Click="trendsBbutton_Click">
                
                <DockPanel Width="130">
                    <Image Source="/images/event.png" Margin="0,0,8,0" HorizontalAlignment="Left"/>
                    <TextBlock Text="Events" VerticalAlignment="Center" Margin="10,0,0,0" HorizontalAlignment="Left"/>
                </DockPanel>
            </Button>
           
            <Button Name="alarmsButton" Style="{StaticResource menuButtonStyle}"  Click="alarmsButton_Click">
                
                <DockPanel Width="130">
                    <Image Source="/images/people.png" Margin="0,0,8,0" HorizontalAlignment="Left"/>
                    <TextBlock Text="Users" VerticalAlignment="Center" Margin="10,0,0,0" HorizontalAlignment="Left"/>
                </DockPanel>
            </Button>
            <Button Name="eventsBbutton" Style="{StaticResource menuButtonStyle}"  Click="eventsBbutton_Click" >
                
                <DockPanel Width="130">
                    <Image Source="/images/settings.png" Margin="0,0,8,0" HorizontalAlignment="Left"/>
                    <TextBlock Text="Settings" VerticalAlignment="Center" Margin="10,0,0,0" HorizontalAlignment="Left"/>
                </DockPanel>
            </Button>
        </StackPanel>

        <!-- Popup for Graphics pages list -->
        <Popup x:Name="graphicsPopup" Placement="Right" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide">
            <Border Background="#FF0C3260" CornerRadius="4" Padding="6" BorderBrush="#0d4986" BorderThickness="1">
                <StackPanel x:Name="graphicsPopupPanel" Orientation="Vertical" />
            </Border>
        </Popup>

        <!-- Header -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Background="#FFFFFFFF" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>
            <TextBlock Name="airaLOGO" 
                       Grid.Column="0" 
                       Text="AIRA AQUATICS" VerticalAlignment="Center" 
                       HorizontalAlignment="Center" 
                       FontSize="30" 
                       Foreground="#0c3260" FontWeight="Bold" />
            <TextBlock Grid.Column="1" Name="PageTitle" 
                       Text="PAGE TITLE" 
                       VerticalAlignment="Bottom" 
                       FontSize="25" FontWeight="Bold" 
                       HorizontalAlignment="Center"/>
            <TextBlock Name="DateTimeLabel" 
                       Grid.Column="2" 
                       Text="" VerticalAlignment="Center" 
                       HorizontalAlignment="Center" 
                       FontSize="16" FontWeight="Bold" />
            <Image x:Name="vaLogo" Source="/images/VA.png" 
                   Grid.Column="3" 
                   HorizontalAlignment="Center" 
                   Height="56" 
                   VerticalAlignment="Center" Width="160"/>
        </Grid>

        <!-- Center content area -->
        <Frame x:Name='mainWindow' Grid.Column="1" Grid.Row="1" BorderBrush="#FFCCCCCC" BorderThickness="0" Background="White" NavigationUIVisibility="Hidden">            
        </Frame>
    </Grid>
</Window>
